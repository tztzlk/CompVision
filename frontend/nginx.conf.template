# Frontend nginx: serves the built Vite SPA and reverse-proxies the API to the
# backend service of the compose network.
#
# ШАБЛОН: официальный образ nginx при старте прогоняет его через envsubst
# (/etc/nginx/templates -> /etc/nginx/conf.d/default.conf). Подставляется ТОЛЬКО переменная API_KEY
# (compose: NGINX_ENVSUBST_FILTER=^API_KEY$), переменные nginx вида $host не трогаются.
#
# Два входа в API:
#   /api/     — для жюри и внешних клиентов (раздел 10 ТЗ): ключ X-API-Key обязан прислать клиент.
#   /ui-api/  — только для веб-интерфейса: nginx переписывает путь в /api/ и сам подставляет
#               X-API-Key, поэтому проверяющему не нужно знать ключ (FAQ п.27: авторизация UI не нужна).
#
# Location priority reminder (nginx picks in this order):
#   1. exact match            `location = /path`
#   2. prefix with ^~         `location ^~ /api/`   (stops regex search)
#   3. regex                  `location ~* \.(js|css|...)$`
#   4. plain prefix           `location /`
# /api/ MUST use `^~`, otherwise a request like /api/v1/export.json would be
# captured by the static-assets regex instead of being proxied.

server {
    listen 80;
    server_name _;

    server_tokens off;

    # Resolve `backend` through Docker's embedded DNS at request time instead
    # of once at startup. Combined with a variable in proxy_pass this means:
    #   - nginx starts fine even if the backend container is not up yet
    #     (a static `proxy_pass http://backend:8000` fails `nginx -t`/startup
    #     with "host not found in upstream" when the name cannot be resolved);
    #   - a recreated backend container (new IP) is picked up without reload.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $backend_upstream http://backend:8000;

    root  /usr/share/nginx/html;
    index index.html;

    # --- compression ------------------------------------------------------
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types
        text/plain
        text/css
        application/javascript
        application/json
        image/svg+xml;

    # --- container health (served by nginx itself, no backend dependency) --
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    # --- backend health exposed through the frontend -----------------------
    # With a variable in proxy_pass the URI part is passed literally, so the
    # upstream path has to be spelled out explicitly here.
    location = /health {
        proxy_pass $backend_upstream/health;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_read_timeout    15s;
        proxy_send_timeout    15s;
    }

    # --- API reverse proxy --------------------------------------------------
    # proxy_pass WITHOUT a URI part -> the original request path is forwarded
    # unchanged: /api/v1/analyze  ->  http://backend:8000/api/v1/analyze
    # (the backend serves its routes under /api/v1/... itself).
    location ^~ /api/ {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        # Video upload: ~29 MB per spec, generous headroom.
        client_max_body_size 200m;
        # Stream the upload body straight to the backend instead of buffering
        # it fully on disk first.
        proxy_request_buffering off;

        # Analysis can take up to ~5 minutes on the GPU worker.
        proxy_connect_timeout 10s;
        proxy_read_timeout    600s;
        proxy_send_timeout    600s;

        # Do not buffer responses (lets streamed/chunked progress responses
        # through immediately).
        proxy_buffering off;
    }

    # --- UI API: ключ подставляет nginx --------------------------------------
    # /ui-api/v1/analyze -> http://backend:8000/api/v1/analyze + X-API-Key из API_KEY.
    # Присланный браузером X-API-Key перезаписывается.
    location ^~ /ui-api/ {
        rewrite ^/ui-api/(.*)$ /api/$1 break;
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header X-API-Key         "${API_KEY}";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        client_max_body_size 200m;
        proxy_request_buffering off;
        proxy_connect_timeout 10s;
        proxy_read_timeout    600s;
        proxy_send_timeout    600s;
        proxy_buffering off;
    }

    # --- hashed static assets: long cache ---------------------------------
    # Vite emits content-hashed filenames in /assets, so "immutable" is safe.
    # index.html is deliberately NOT matched here so deployments are picked
    # up right away.
    location ~* \.(js|mjs|css|map|png|jpg|jpeg|gif|webp|avif|svg|ico|woff2?|ttf|eot)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
        try_files $uri =404;
    }

    # --- SPA fallback -------------------------------------------------------
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Never cache the entry point so clients get new asset hashes.
    location = /index.html {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }
}
