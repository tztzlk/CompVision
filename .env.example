# Скопируйте в .env:  cp .env.example .env
# Файл .env обязателен для запуска (docker compose ругается, если его нет).

# API-ключ для доступа к backend (передаётся жюри; заголовок X-API-Key).
# Сгенерировать: openssl rand -hex 32
API_KEY=change-me-generate-with-openssl-rand-hex-32

# Порт на хосте, на котором доступен веб-интерфейс (единственный опубликованный порт).
FRONTEND_PORT=8080

# Устройство для инференса воркера: cuda | cpu.
# Для cpu также уберите блок deploy у сервиса worker в docker-compose.yml.
WORKER_DEVICE=cuda

# Уровень логирования backend/worker: debug | info | warning | error.
LOG_LEVEL=info

# Максимальный размер загружаемого видео, МБ.
MAX_UPLOAD_MB=200

# Лимит времени обработки одного видео, секунд (5 минут по ТЗ).
JOB_TIMEOUT_SEC=300

# Сбор отзывов проверяющего «подтвердить/отклонить нарушение» (таблица feedback): 0 — выкл (по умолчанию), 1 — вкл.
# Раздел 10 ТЗ: тестовые видео нельзя использовать для обучения, публиковать или передавать третьим лицам,
# поэтому при проверке жюри оставляйте 0. Включать только на собственном датасете команды (разбор ошибок).
FEEDBACK_ENABLED=0

# Период опроса очереди worker'ом, секунд (необязательно, по умолчанию 1.0).
# WORKER_POLL_SEC=1.0

# Поза (экспериментально, по умолчанию выключено): 1 — точки ViTPose и признаки позы в сцене.
# Нужны transformers >= 4.48 и веса (scripts/download_models.py --only vitpose); README, «Поза».
# ENABLE_POSE=0
# Поза на каждом k-м состоянии, если не укладываемся по времени (по умолчанию 1 — каждое).
# POSE_EVERY_K=1
# Головы жестов поверх точек (scripts/train_pose_heads.py): путь к .npz относительно каталога моделей,
# например heads/pose_gestures.npz; пусто — только геометрические признаки.
# POSE_GESTURE_HEADS=
